'                refEl = checkedEl || els[els.length - 1];\n' +
'            } else {\n' +
'                userAns = (els[0].value || "").trim();\n' +
'                els[0].disabled = true;\n' +
'                refEl = els[0];\n' +
'            }\n' +
'            var isOk = checkAns(userAns, ANSWERS[id]);\n' +
'            if (isOk) score++;\n' +
'            var pNum = PMETA[id] || 1;\n' +
'            if (!perP[pNum]) perP[pNum] = { s: 0, t: 0 };\n' +
'            perP[pNum].t++;\n' +
'            if (isOk) perP[pNum].s++;\n' +
'            var fb = document.createElement("span");\n' +
'            fb.className = "fb " + (isOk ? "ok" : "no");\n' +
'            fb.innerHTML = isOk\n' +
'                ? " <i class=\\"fa-solid fa-circle-check\\"></i>"\n' +
'                : " <i class=\\"fa-solid fa-circle-xmark\\"></i> <small style=\\"font-weight:500\\">(Ans: " + primaryAns(ANSWERS[id]) + ")</small>";\n' +
'            if (isMulti) {\n' +
'                var wrap = refEl.closest("label") || refEl.parentNode;\n' +
'                wrap.style.outline = "2px solid " + (isOk ? "#2e7d32" : "#dc2626");\n' +
'                wrap.style.borderRadius = "6px";\n' +
'                wrap.parentNode.insertBefore(fb, wrap.nextSibling);\n' +
'            } else {\n' +
'                refEl.style.border = "2px solid " + (isOk ? "#2e7d32" : "#dc2626");\n' +
'                refEl.style.background = isOk ? "#f0fdf4" : "#fff7f7";\n' +
'                refEl.parentNode.insertBefore(fb, refEl.nextSibling);\n' +
'            }\n' +
'        }\n' +
'\n' +
'        var pct = total > 0 ? Math.round(score / total * 100) : 0;\n' +
'        // Raw score is scaled to the 40-question paper so shorter practice\n' +
'        // sets still map onto the same scale.\n' +
'        var rawEq = (total === 40) ? score : Math.round(score / total * 40);\n' +
'        var ieltsBand = bandFor(rawEq);\n' +
'        var band = pct >= 80 ? "&#127942; Excellent!" : pct >= 60 ? "&#128077; Good work" : pct >= 40 ? "&#128218; Keep practising" : "&#128170; Don\'t give up";\n' +
'        var breakHTML = "";\n' +
'        if (NP > 1) {\n' +
'            breakHTML = \'<div class="score-break">\';\n' +
'            for (var pn = 1; pn <= NP; pn++) {\n' +
'                var r = perP[pn] || { s: 0, t: 0 };\n' +
'                breakHTML += \'<div class="score-pill">Passage \' + pn + \': <b>\' + r.s + \'/\' + r.t + \'</b></div>\';\n' +
'            }\n' +
'            breakHTML += \'</div>\';\n' +
'        }\n' +
'        var scaleNote = (total === 40)\n' +
'            ? "IELTS Academic Reading"\n' +
'            : "scaled from " + total + " questions to the 40-question scale";\n' +
'        var levelNote = (LEVEL === "core")\n' +
'            ? \'<div class="band-caveat"><i class="fa-solid fa-triangle-exclamation"></i>L\\u01b0u \\u00fd: \\u0110i\\u1ec3m band n\\u00e0y ch\\u1ec9 mang t\\u00ednh tham kh\\u1ea3o t\\u1eeb c\\u00f4ng c\\u1ee5 n\\u1ed9i b\\u1ed9, KH\\u00d4NG ph\\u1ea3n \\u00e1nh k\\u1ebft qu\\u1ea3 thi IELTS th\\u1eadt. \\u0110\\u1ec3 bi\\u1ebft \\u0111i\\u1ec3m ch\\u00ednh x\\u00e1c, h\\u00e3y l\\u00e0m \\u0111\\u1ec1 thi ch\\u00ednh th\\u1ee9c (Cambridge, IDP, British Council...).</div>\'\n' +
'            : \'<div class="band-caveat"><i class="fa-solid fa-triangle-exclamation"></i>L\\u01b0u \\u00fd: \\u0110\\u1ec1 n\\u00e0y \\u0111\\u00e3 \\u0111\\u01a1n gi\\u1ea3n ho\\u00e1 t\\u1eeb \\u0111\\u1ec1 thi g\\u1ed1c (m\\u1ee9c \' + LEVEL_LABEL + \'), n\\u00ean \\u0111i\\u1ec3m band \\u1edf \\u0111\\u00e2y CH\\u1ec8 mang t\\u00ednh tham kh\\u1ea3o, KH\\u00d4NG t\\u01b0\\u01a1ng \\u0111\\u01b0\\u01a1ng v\\u1edbi \\u0111\\u1ec1 thi IELTS th\\u1eadt.</div>\';\n' +
'        var bandHTML =\n' +
'            \'<div class="band-box">\' +\n' +
'              \'<div class="band-label">Estimated Band</div>\' +\n' +
'              \'<div class="band-num">\' + ieltsBand + \'</div>\' +\n' +
'              \'<div class="band-note">\' + scaleNote + \'</div>\' +\n' +
'            \'</div>\' + levelNote;\n' +
'\n' +
'        document.getElementById("scoreBox").innerHTML =\n' +
'            \'<div class="score-main">\' + score + \' / \' + total + \'</div>\' +\n' +
'            \'<div class="score-bar-wrap"><div class="score-bar" style="width:0%"></div></div>\' +\n' +
'            \'<div class="score-sub">\' + pct + \'% correct &nbsp;&middot;&nbsp; \' + band + \'</div>\' +\n' +
'            bandHTML + breakHTML;\n' +
'        setTimeout(function() {\n' +
'            var bar = document.querySelector(".score-bar");\n' +
'            if (bar) bar.style.width = pct + "%";\n' +
'        }, 60);\n' +
'\n' +
'        document.getElementById("btnSubmit").disabled = true;\n' +
'        document.getElementById("btnExplain").disabled = false;\n' +
'    }\n' +
'\n' +
'    var explainLoaded = false;\n' +
'\n' +
'    function openExplain() {\n' +
'        document.getElementById("explainPanel").classList.add("open");\n' +
'        if (!explainLoaded) loadExplanations();\n' +
'    }\n' +
'\n' +
'    function closeExplainPanel(e) {\n' +
'        if (e.target === document.getElementById("explainPanel"))\n' +
'            document.getElementById("explainPanel").classList.remove("open");\n' +
'    }\n' +
'\n' +
'    // Explanations are baked into this file at generation time. There is NO API\n' +
'    // key and NO network call here, so this file is safe to publish or share.\n' +
'    function loadExplanations() {\n' +
'        explainLoaded = true;\n' +
'        var body = document.getElementById("explainBody");\n' +
'        if (EXPLANATIONS && Object.keys(EXPLANATIONS).length > 0) {\n' +
'            renderExplanations(EXPLANATIONS);\n' +
'            return;\n' +
'        }\n' +
'        renderExplanations({});\n' +
'    }\n' +
'\n' +
'    function renderExplanations(exps) {\n' +
'        var body = document.getElementById("explainBody");\n' +
'        var html = "", lastP = null;\n' +
'        for (var id in ANSWERS) {\n' +
'            var els = document.querySelectorAll("[name=\\"" + id + "\\"]");\n' +
'            var userVal = "";\n' +
'            if (els.length) {\n' +
'                var isMulti = els.length > 1 || els[0].type === "radio";\n' +
'                if (isMulti) {\n' +
'                    var checkedEl = document.querySelector("[name=\\"" + id + "\\"]:checked");\n' +
'                    userVal = checkedEl ? (checkedEl.value || "").trim() : "";\n' +
'                } else {\n' +
'                    userVal = (els[0].value || "").trim();\n' +
'                }\n' +
'            }\n' +
'            var correct = primaryAns(ANSWERS[id]);\n' +
'            var isOk = checkAns(userVal, ANSWERS[id]);\n' +
'            var exp = exps[id] || "No explanation available.";\n' +
'            var pNow = PMETA[id] || 1;\n' +
'            if (NP > 1 && pNow !== lastP) {\n' +
'                html += \'<div class="exp-group">Passage \' + pNow + \' &middot; \' + (PLABELS[pNow] || "") + \'</div>\';\n' +
'                lastP = pNow;\n' +
'            }\n' +
'            html += \'<div class="exp-item">\' +\n' +
'                \'<div class="exp-q">\' +\n' +
'                    \'<span style="font-size:0.75rem;text-transform:uppercase;">\' + id + \'</span>\' +\n' +
'                    \'<span class="chip \' + (isOk ? "chip-ok" : "chip-bad") + \'">\' + correct + \'</span>\' +\n' +
'                    (isOk ? "" : \'<span style="color:#9ca3af;font-size:0.78rem;font-weight:500;">Your answer: \' + (userVal || \'—\') + \'</span>\') +\n' +
'                \'</div>\' +\n' +
'                \'<div class="exp-text">\' + exp + \'</div>\' +\n' +
'                \'</div>\';\n' +
'        }\n' +
'        body.innerHTML = html || \'<p style="text-align:center;color:#9ca3af;">No explanations available.</p>\';\n' +
'    }\n' +
'<\/script>\n' +
'</body>\n' +
'</html>';

        var blob = new Blob([content], { type: 'text/html' });
        var link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        // Titles now come from passage headings, which may contain : ? / etc.
        // Strip anything unsafe for a filename and stamp the date so repeated
        // builds don't all land as the same name.
        var slug  = title.replace(/[^\w\s-]/g, '').replace(/\s+/g, '_').replace(/_+/g, '_').replace(/^_|_$/g, '');
        if (!slug) slug = 'IELTS_Reading';
        if (slug.length > 60) slug = slug.slice(0, 60).replace(/_$/, '');
        link.download = slug + '_' + levelLabel.replace(/\s/g, '_') + '_' + nP + 'P_' + stamp + '.html';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }

    // Show the real key state as soon as the page opens, not just after saving.
    // This script sits below the markup, so the elements already exist and we can
    // update straight away rather than waiting on an event that may have fired.
    refreshKeyBar();
    renderHistory();
</script>
