        // "**1. TRUE** — explanation" (bold-wrapped number+answer, em-dash
        // or en-dash instead of a colon) — different models format this
        // differently and all three are common in practice.
        var starts = [], startRe = /\*{0,2}(\d+)\s*[.\-)]\s*([^*:\n—–]+?)\*{0,2}\s*(?::|—|–)\s*/g, m;
