        // globally unique thanks to renumber(), so nothing can overwrite anything.
        var answers = {}, explanations = {}, meta = {}, labelsByP = {};
        passages.forEach(function(p, i) {
            Object.keys(p.answers).forEach(function(k) { answers[k] = p.answers[k]; meta[k] = i + 1; });
            Object.keys(p.explanations).forEach(function(k) { explanations[k] = p.explanations[k]; });
            labelsByP[i + 1] = esc(p.heading);
        });

        var answersJSON      = JSON.stringify(answers).replace(/<\/script>/gi, '<\\/script>');
        var explanationsJSON = JSON.stringify(explanations || {}).replace(/<\/script>/gi, '<\\/script>');
        var metaJSON         = JSON.stringify(meta).replace(/<\/script>/gi, '<\\/script>');
        var plabelsJSON      = JSON.stringify(labelsByP).replace(/<\/script>/gi, '<\\/script>');

        // Ảnh minh hoạ: mỗi ảnh khai báo "câu X đến câu Y" (toàn đề, không
        // theo passage cụ thể) — ở đây ta tự tìm passage nào có [first,last]
        // chứa số câu bắt đầu (fromQ) và gắn ảnh vào đúng passage đó.
        var IMAGES = [];
        IMAGE_ENTRIES.forEach(function(e) {
            if (!e.dataURI || !e.fromQ) return;
            var target = null;
            for (var i = 0; i < passages.length; i++) {
                var p = passages[i];
                if (e.fromQ >= p.first && e.fromQ <= p.last) { target = i + 1; break; }
            }
            if (!target) {
                log('Hình minh hoạ cho câu ' + e.fromQ + ' không khớp v\u1edbi b\u00e0i \u0111\u1ecdc n\u00e0o \u2014 \u0111\u00e3 b\u1ecf qua.', 'warn');
                return;
            }
            IMAGES.push({ p: target, q: e.fromQ, toQ: e.toQ || null, src: e.dataURI });
        });
        var imagesJSON = JSON.stringify(IMAGES).replace(/<\/script>/gi, '<\\/script>');
        var safeTitle        = title.replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
