<script>
    // API key embedded — not visible in UI
    // The API key is NEVER stored in this file. It lives in this browser's
    // localStorage, so the generator can be copied, emailed or uploaded safely.
    var KEY_STORE = 'gg_reading_api_key';

    /* =====================================================================
       GENERATION HISTORY (v10.3)
       ---------------------------------------------------------------------
       Without this, every visit starts from a blank slate and the topic
       picker happily serves the same subject it served last week. The
       history lives in this browser's localStorage, alongside the API key —
       which we already know works in your setup, since the key persists.
       Two consequences worth being clear about:
         · it is per-browser and per-machine. GG1's laptop will not know what
           GG2's laptop has generated. Hence Export/Import.
         · clearing browsing data wipes it. Export occasionally.
       ===================================================================== */
    var HIST_STORE = 'gg_reading_history';
    var HIST_MAX   = 150;   // keep the prompt payload bounded

    function loadHistory() {
        try {
            var raw = localStorage.getItem(HIST_STORE);
            var arr = raw ? JSON.parse(raw) : [];
            return Object.prototype.toString.call(arr) === '[object Array]' ? arr : [];
        } catch (e) { return []; }
    }

    function saveHistory(arr) {
        try {
            localStorage.setItem(HIST_STORE, JSON.stringify(arr.slice(-HIST_MAX)));
            return true;
        } catch (e) {
            log('Could not save topic history to this browser (' + e.name + '). Repeat protection will not survive a refresh.', 'warn');
            return false;
        }
    }

    // topic = the seed we asked for; title = what the model actually wrote;
    // open = first few words, used to stop every passage starting the same way.
    function recordTopic(topic, title, passageHTML, level) {
        var h = loadHistory();
        var open = String(passageHTML || '').replace(/<[^>]+>/g, ' ')
                     .replace(/^\s*[A-Z]\.\s*/, '').trim().split(/\s+/).slice(0, 7).join(' ');
        h.push({ t: topic || '', ti: title || '', o: open, lv: level || '', d: new Date().toISOString().slice(0, 10) });
        saveHistory(h);
        renderHistory();
    }

    function renderHistory() {
        var h    = loadHistory();
        var box  = document.getElementById('histList');
        var cnt  = document.getElementById('histCount');
        if (!box || !cnt) return;
        cnt.textContent = h.length ? (h.length + ' passage' + (h.length > 1 ? 's' : '') + ' remembered') : 'nothing generated yet';
        if (!h.length) { box.innerHTML = '<div class="hist-empty">No history yet. Everything generated in Author mode is logged here so it is never repeated.</div>'; return; }
        var rows = h.slice().reverse().slice(0, 40).map(function(e) {
            return '<div class="hist-row"><span class="hist-date">' + esc(e.d) + '</span>' +
                   '<span class="hist-ti">' + esc(e.ti || e.t) + '</span>' +
                   '<span class="hist-lv">' + esc(e.lv) + '</span></div>';
        }).join('');
        box.innerHTML = rows + (h.length > 40 ? '<div class="hist-empty">\u2026 and ' + (h.length - 40) + ' older.</div>' : '');
    }

    function histExport() {
        var h = loadHistory();
        if (!h.length) { log('Nothing to export yet.', 'warn'); return; }
        var ta = document.getElementById('histIO');
        ta.style.display = 'block';
        ta.value = JSON.stringify(h);
        ta.select();
        log('History exported below \u2014 copy it and paste into the other campus\u2019s browser, then click Import there.', 'ok');
    }

    function histImportOpen() {
        var ta = document.getElementById('histIO');
        ta.style.display = 'block';
        ta.value = '';
        ta.placeholder = 'Paste exported history here, then click Import again to merge.';
        ta.focus();
        log('Paste the exported history into the box, then press Import again.');
    }

    function histImport() {
        var ta = document.getElementById('histIO');
        if (ta.style.display !== 'block' || !ta.value.trim()) { histImportOpen(); return; }
        var incoming;
        try { incoming = JSON.parse(ta.value.trim()); } catch (e) { log('That is not valid exported history.', 'err'); return; }
        if (Object.prototype.toString.call(incoming) !== '[object Array]') { log('That is not valid exported history.', 'err'); return; }
        var h = loadHistory(), seen = {}, merged = [];
        h.concat(incoming).forEach(function(e) {
            if (!e || typeof e !== 'object') return;
            var k = (e.ti || '') + '|' + (e.t || '');
            if (k === '|' || seen[k]) return;
            seen[k] = 1; merged.push(e);
        });
        saveHistory(merged);
        ta.style.display = 'none'; ta.value = '';
        renderHistory();
        log('Merged \u2014 now remembering ' + Math.min(merged.length, HIST_MAX) + ' passages.', 'ok');
    }

    function histClear() {
        var h = loadHistory();
        if (!h.length) return;
        if (!confirm('Xo\u00e1 to\u00e0n b\u1ed9 l\u1ecbch s\u1eed ' + h.length + ' b\u00e0i \u0111\u00e3 t\u1ea1o?\n\nSau khi xo\u00e1, m\u00e1y c\u00f3 th\u1ec3 sinh l\u1ea1i c\u00e1c ch\u1ee7 \u0111\u1ec1 c\u0169.')) return;
        try { localStorage.removeItem(HIST_STORE); } catch (e) {}
        renderHistory();
        log('History cleared. Old topics can now come round again.', 'warn');
    }

    function getKey()  { try { return localStorage.getItem(KEY_STORE) || ''; } catch (e) { return ''; } }

    function saveKey() {
        var v   = document.getElementById('keyInput').value.trim();
        var err = document.getElementById('keyErr');
        if (!/^sk-ant-/.test(v)) {
            err.textContent = 'That does not look like an Anthropic key \u2014 it should start with "sk-ant-".';
            err.classList.add('show');
            return;
        }
        try { localStorage.setItem(KEY_STORE, v); }
        catch (e) {
            err.textContent = 'Could not save \u2014 this browser is blocking local storage.';
            err.classList.add('show');
            return;
        }
        err.classList.remove('show');
        document.getElementById('keyInput').value = '';
        document.getElementById('keyForm').classList.remove('open');
        refreshKeyBar();
        log('API key saved to this browser. Ready to generate tests.', 'ok');
    }

    function showKeyForm() {
        document.getElementById('keyForm').classList.add('open');
        document.getElementById('keyInput').focus();
    }

    function toggleKeyForm() {
        var f = document.getElementById('keyForm');
        if (f.classList.contains('open')) { f.classList.remove('open'); return; }
        showKeyForm();
    }

    // Deliberately quiet: just a small dot. Green once a key is stored, amber and
    // pulsing when one is needed. No text, nothing to draw a passing eye.
    function refreshKeyBar() {
        var has = !!getKey();
        var orb = document.getElementById('keyOrb');
        orb.classList.toggle('missing', !has);
        orb.title = has ? 'API key saved \u00b7 click to change' : 'No API key \u2014 click to add';
        if (!has) document.getElementById('keyForm').classList.add('open');
    }

    function log(msg, type) {
        var con = document.getElementById('console');
        var div = document.createElement('div');
        div.className = 'log-line' + (type === 'err' ? ' log-err' : type === 'ok' ? ' log-ok' : type === 'warn' ? ' log-warn' : '');
        div.innerText = '[' + new Date().toLocaleTimeString() + '] ' + msg;
        con.appendChild(div);
        con.scrollTop = con.scrollHeight;
    }

    function sleep(ms) { return new Promise(function(r) { setTimeout(r, ms); }); }

    // A 3-passage test fires three calls back to back, so a rate-limit (429) or
    // overload (529) is far more likely than in single-passage mode. Back off and
    // retry rather than losing passages already generated. Credit/auth errors
    // (400/401/403) fail immediately — retrying those never helps.
    async function callClaude(prompt, maxTokens, attempt, salvage, effort) {
        maxTokens = maxTokens || 16000;
        attempt   = attempt || 1;
        effort    = effort || 'high';

        var payload = {
            model: 'claude-sonnet-5',
            max_tokens: maxTokens,
            messages: [{ role: 'user', content: prompt }],
            output_config: { effort: effort }
        };

        var response = await fetch('https://api.anthropic.com/v1/messages', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'x-api-key': getKey(),
                'anthropic-version': '2023-06-01',
                'anthropic-dangerous-direct-browser-access': 'true'
            },
            body: JSON.stringify(payload)
        });

        if (!response.ok) {
            if ((response.status === 429 || response.status === 529 || response.status >= 500) && attempt < 4) {
                var wait = attempt * 10;
                log('Server busy (HTTP ' + response.status + ') \u2014 retrying in ' + wait + 's \u00b7 attempt ' + attempt + '/3\u2026', 'warn');
                await sleep(wait * 1000);
                return callClaude(prompt, maxTokens, attempt + 1, salvage, effort);
            }
            var err = {};
            try { err = await response.json(); } catch (e) {}
            var msg = err.error ? err.error.message : 'HTTP ' + response.status;

            // Older/other models reject output_config. Drop it and carry on rather
            // than failing the whole test over an optional cost control.
            if (response.status === 400 && /output_config|effort/i.test(msg) && attempt < 4) {
                log('This model does not accept the effort setting \u2014 retrying without it.', 'warn');
                EFFORT_SUPPORTED = false;
                return callClaudeRaw(prompt, maxTokens, salvage);
            }
            throw new Error(msg);
        }

        var result = await response.json();
        return handleResult(result, prompt, maxTokens, attempt, salvage, effort);
    }

    // Fallback path with no output_config, for models that reject it.
    var EFFORT_SUPPORTED = true;
    async function callClaudeRaw(prompt, maxTokens, salvage) {
        var response = await fetch('https://api.anthropic.com/v1/messages', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'x-api-key': getKey(),
                'anthropic-version': '2023-06-01',
                'anthropic-dangerous-direct-browser-access': 'true'
            },
            body: JSON.stringify({
                model: 'claude-sonnet-5',
                max_tokens: maxTokens,
                messages: [{ role: 'user', content: prompt }]
            })
        });
        if (!response.ok) {
            var err = {};
            try { err = await response.json(); } catch (e) {}
            throw new Error(err.error ? err.error.message : 'HTTP ' + response.status);
        }
        return handleResult(await response.json(), prompt, maxTokens, 4, salvage, null);
    }

    async function handleResult(result, prompt, maxTokens, attempt, salvage, effort) {
        var _blocks = (result.content || []).filter(function (b) { return b.type === 'text' && typeof b.text === 'string'; });
        var _text   = _blocks.map(function (b) { return b.text; }).join('').trim();

        // Cost telemetry. max_tokens is only a CEILING — you are billed for what
        // is actually generated — so the number that matters is output_tokens,
        // and thinking_tokens tells you how much of it you never got to keep.
        var u  = result.usage || {};
        var th = (u.output_tokens_details && u.output_tokens_details.thinking_tokens) || 0;
        log('  \u21b3 tokens: in ' + (u.input_tokens || '?') + ' \u00b7 out ' + (u.output_tokens || '?') +
            (th ? ' (of which ' + th + ' thinking)' : '') +
            ' \u00b7 ceiling ' + maxTokens + (effort ? ' \u00b7 effort ' + effort : '') +
            ' \u00b7 stop: ' + (result.stop_reason || '?'));

        if (result.stop_reason === 'max_tokens') {
            // Before paying to generate the whole thing again, check whether the
            // part we actually need already arrived intact.
            if (typeof salvage === 'function' && salvage(_text)) {
                log('  \u21b3 Ceiling hit, but the content I need is already complete \u2014 keeping it instead of paying twice.', 'warn');
                return _text;
            }
            if (maxTokens < 32000 && attempt < 4) {
                var bigger = Math.min(maxTokens * 2, 32000);
                log('Cut off at ' + maxTokens + ' tokens \u2014 that whole generation is billed and discarded. Retrying with ' + bigger + '\u2026', 'warn');
                await sleep(1000);
                return callClaude(prompt, bigger, attempt + 1, salvage, effort);
            }
        }

        return _text;
    }

    // Truncation guards: "did the block I care about finish cleanly?"
    function passageComplete(t) {
        var i = t.indexOf('===GG_PASSAGE===');
        if (i === -1) return false;
        var body = t.substring(i + 16).split('===GG_END===')[0].trim();
        return body.length > 400 && /<\/p>$/.test(body);
    }

    function questionsComplete(t) {
        var q = grabBlock(t, '===GG_QUESTIONS===', '===GG_ANSWERS===');
        var a = safeJSONObject(grabBlock(t, '===GG_ANSWERS===', '===GG_EXPLANATIONS==='));
        return !!(q && a && Object.keys(a).length);
    }

    // Attempts to fix the most common way Claude's JSON breaks: an unescaped
    // " or raw newline inside a string value (e.g. quoted speech in the passage).
    // Walks the text tracking string state; if a " appears inside a string and
    // is NOT followed (after optional whitespace) by , } ] or :  it's treated
    // as literal content and escaped instead of closing the string.
    function repairJSON(text) {
        var out = '', inStr = false, n = text.length;
        for (var i = 0; i < n; i++) {
            var ch = text[i];
            if (!inStr) {
                if (ch === '"') inStr = true;
                out += ch;
                continue;
            }
            if (ch === '\\') {
                var nx = text[i + 1];
                if (nx === '"' || nx === '\\' || nx === '/' || nx === 'b' || nx === 'f' ||
                    nx === 'n' || nx === 'r' || nx === 't') { out += ch + nx; i++; }
                else if (nx === 'u' && /^[0-9a-fA-F]{4}$/.test(text.substr(i + 2, 4))) { out += ch + nx; i++; }
                else { out += '\\\\'; }   // escape sai -> biến dấu \ thành ký tự thường
                continue;
            }
            if (ch === '\n' || ch === '\r') { out += '\\n'; continue; }
            if (ch === '\t') { out += '\\t'; continue; }
            if (ch === '"') {
                var j = i + 1;
                while (j < n && /\s/.test(text[j])) j++;
                var nextCh = text[j];
                if (nextCh === undefined || nextCh === ',' || nextCh === '}' || nextCh === ']' || nextCh === ':') {
                    inStr = false;
                    out += ch;
                } else {
                    out += '\\"';
                }
                continue;
            }
            out += ch;
        }
        return out;
    }

    // Lấy object JSON ĐẦU TIÊN khớp ngoặc (bỏ mọi nội dung thừa phía sau).
    function extractFirstObject(text) {
        var start = text.indexOf('{');
        if (start === -1) return null;
        var depth = 0, inStr = false, esc = false;
        for (var i = start; i < text.length; i++) {
            var ch = text[i];
            if (inStr) {
                if (esc) esc = false;
                else if (ch === '\\') esc = true;
                else if (ch === '"') inStr = false;
            } else {
                if (ch === '"') inStr = true;
                else if (ch === '{') depth++;
                else if (ch === '}') { depth--; if (depth === 0) return text.substring(start, i + 1); }
            }
        }
        return text.substring(start);   // không khớp -> để repairJSON thử cứu
    }

    function parseJSON(text) {
        text = text.replace(/^```(?:json)?\s*/i, '').replace(/\s*```$/i, '').trim();
        var s = text.indexOf('{'), end = text.lastIndexOf('}');
        if (s === -1) throw new Error('Could not find JSON in AI response. Please try again.');

        // Thử theo thứ tự: (1) object đầu tiên khớp ngoặc, (2) từ '{' đầu tới '}' cuối.
        // Mỗi cái thử parse thẳng rồi mới thử repairJSON.
        var candidates = [];
        var first = extractFirstObject(text);
        if (first) candidates.push(first);
        if (end > s) candidates.push(text.substring(s, end + 1));

        var lastErr;
        for (var c = 0; c < candidates.length; c++) {
            try { return JSON.parse(candidates[c]); }
            catch (e1) {
                lastErr = e1;
                try { return JSON.parse(repairJSON(candidates[c])); }
                catch (e2) { lastErr = e2; }
            }
        }
        throw new Error('Invalid JSON from AI (' + (lastErr && lastErr.message) + '). Please try again.');
    }

    // Parse 1 khối JSON nhỏ (answers/explanations) một cách khoan dung.
    function safeJSONObject(str) {
        if (!str) return null;
        var obj = extractFirstObject(str);
        if (!obj) return null;
        try { return JSON.parse(obj); }
        catch (e1) { try { return JSON.parse(repairJSON(obj)); } catch (e2) { return null; } }
    }

