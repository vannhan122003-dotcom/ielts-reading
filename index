    // ---- Whole-test auto-split -----------------------------------------
    // Takes one big paste (or uploaded .md) containing all passages, their
    // questions, and an answer key, and splits it into the per-passage
    // boxes this tool already knows how to process — so the teacher never
    // has to manually copy sections apart. Understands the template this
    // conversation has used throughout:
    //   ## PASSAGE 1: Title
    //   ...passage text + ## QUESTIONS 1-13...
    //   ## PASSAGE 2: Title
    //   ...
    //   ## ANSWER KEY
    //   Passage 1 (Questions 1-13): 1-TRUE: because... 2-FALSE: because...
    //   Passage 2 (Questions 14-26): ...
    // Every header is tolerant of a missing "##" and of "Passage" vs
    // "PASSAGE", matching the same tolerant style as parseAnswerKeyCombined.
    function splitFullTestText(raw) {
        var text = String(raw || '').replace(/\r\n?/g, '\n');

        // Find each "PASSAGE N" header (with or without "##", with or
        // without "READING" before it, with or without a title after the
        // colon) and the "ANSWER KEY" header. Tolerates "# READING PASSAGE 1"
        // as well as the canonical "## PASSAGE 1: Title" — different models
        // phrase this header differently and both are common in practice.
        // [ \t]* (not \s*) on purpose: \s also matches newlines, which was
        // greedily skipping blank lines and grabbing the *next* heading line
        // as if it were inline title text on the PASSAGE line itself.
        var passageRe = /^#{0,2}[ \t]*(?:READING[ \t]+)?PASSAGE[ \t]*([123])[ \t]*:?[ \t]*(.*)$/gim;
        var found = [], m;
        while ((m = passageRe.exec(text)) !== null) {
            found.push({ n: parseInt(m[1], 10), title: m[2].trim().replace(/\*+$/, ''), at: m.index, lineEnd: passageRe.lastIndex });
        }
        // If a passage header carried no title (e.g. "# READING PASSAGE 1"
        // with the actual title on the next line as its own heading, like
        // "## Lighthouses and Their Keepers"), pull that next line in as the
        // title and advance lineEnd past it so it isn't duplicated in the body.
        found.forEach(function(f) {
            if (f.title) return;
            var rest = text.slice(f.lineEnd);
            var blank = rest.match(/^\n+/);
            var skipLen = blank ? blank[0].length : 0;
            var firstLine = rest.slice(skipLen).split('\n')[0];
            var headingMatch = firstLine.match(/^#{1,3}\s*(.+?)\s*$/);
            if (headingMatch) {
                f.title = headingMatch[1].trim();
                f.lineEnd += skipLen + firstLine.length;
            }
        });
        found.sort(function(a, b) { return a.at - b.at; });
        // De-duplicate: keep only the first header found for each passage
        // number (a passage's own title might mention "Passage 2" in prose).
        var seen = {}, passages = [];
        found.forEach(function(f) { if (!seen[f.n]) { seen[f.n] = true; passages.push(f); } });
        passages.sort(function(a, b) { return a.n - b.n; });

        if (!passages.length) {
            return { ok: false, error: 'Kh\u00f4ng t\u00ecm th\u1ea5y ti\u00eau \u0111\u1ec1 "PASSAGE 1" trong n\u1ed9i dung d\u00e1n v\u00e0o \u2014 ki\u1ec3m tra l\u1ea1i \u0111\u1ecb\u1ecbnh d\u1ea1ng.' };
        }

        var keyIdx = text.search(/^#{0,2}\s*ANSWER\s*KEY\b/im);

        // Body of each passage = from right after its header line to the
        // start of the next passage header (or ANSWER KEY, or end of text).
        var bodies = {};
        passages.forEach(function(p, i) {
            var next = passages[i + 1];
            var end = next ? next.at : (keyIdx >= 0 ? keyIdx : text.length);
            bodies[p.n] = text.slice(p.lineEnd, end).trim();
        });

        // Answer key: split on "Passage N (...)" markers within the
        // ANSWER KEY section, same tolerant style as elsewhere in this tool.
        var keyChunks = {};
        if (keyIdx >= 0) {
            var keySection = text.slice(keyIdx);
            // Tolerates "Passage 1 (Questions 1-13):" (original expected
            // format) as well as a bare markdown heading "### Passage 1"
            // with no question range — models often drop the parenthetical
            // when they format the answer key as headings instead of prose.
            // Anchored to line start (^ with 'm') so a closing summary line
            // like "...Passage 1 is within 450-620; Passage 2 is longer
            // than Passage 1..." doesn't get mistaken for real section
            // headers — those mentions are mid-sentence, not line-initial.
            var keyPassageRe = /^#{0,3}\s*\*{0,2}\s*Passage\s*([123])\s*(?:\([^)]*\))?\s*:?\s*\*{0,2}\s*/gim;
            var starts = [], km;
            while ((km = keyPassageRe.exec(keySection)) !== null) {
                starts.push({ n: parseInt(km[1], 10), end: keyPassageRe.lastIndex, at: km.index });
            }
            // Keep only the FIRST header found per passage number, same
            // defensive dedup as the main passage-header parsing above —
            // a later, spurious match must never overwrite the real chunk.
            var keySeen = {}, dedupedStarts = [];
            starts.forEach(function(s) { if (!keySeen[s.n]) { keySeen[s.n] = true; dedupedStarts.push(s); } });
            dedupedStarts.forEach(function(s, i) {
                var next = dedupedStarts[i + 1];
                keyChunks[s.n] = keySection.slice(s.end, next ? next.at : keySection.length)
                    .trim().replace(/^\*+\s*/, '').replace(/\*+\s*$/, '').trim();
            });
        }

        return { ok: true, passages: passages, bodies: bodies, keyChunks: keyChunks };
    }

    // File upload just loads the text — the actual split happens
    // automatically inside buildTest() when a level button is clicked, so
    // there's no separate "split" step to run here. A quick preview count
    // is shown immediately so a bad paste is obvious before spending tokens.
    // .docx is a zip of XML, not plain text — it can't just be read with
    // FileReader.readAsText() the way .md/.txt can. Mammoth.js unpacks it
    // client-side (no server, no upload of the file anywhere) and gives us
    // HTML we can walk ourselves, converting Word's real heading/bold
    // styles into the "## " / "**bold**" markers the splitter looks for —
    // this matters because a .docx heading is usually applied as a Word
    // style, not literal typed "##" characters, so the splitter would see
    // nothing at all without this conversion step.
    function docxHtmlToMarkdown(html) {
        var container = document.createElement('div');
        container.innerHTML = html;
        var lines = [];

        function tableToMarkdown(table) {
            var rows = Array.prototype.slice.call(table.querySelectorAll('tr'));
            var out = [];
            rows.forEach(function(tr, i) {
                var cells = Array.prototype.slice.call(tr.querySelectorAll('th,td'))
                    .map(function(c) { return c.textContent.trim().replace(/\|/g, '\\|'); });
                out.push('| ' + cells.join(' | ') + ' |');
                if (i === 0) out.push('|' + cells.map(function() { return '---'; }).join('|') + '|');
            });
            return out.join('\n');
        }

        Array.prototype.forEach.call(container.children, function(node) {
            var tag = node.tagName ? node.tagName.toLowerCase() : '';
            if (/^h[1-6]$/.test(tag)) {
                lines.push('## ' + node.textContent.trim());
            } else if (tag === 'table') {
                lines.push(tableToMarkdown(node));
            } else if (tag === 'p' || tag === 'li') {
                // Preserve bold runs as **text** so answer-key markers like
                // "**Part 5:**" or "**Passage 1 (Questions 1-13):**" still
                // parse correctly even if the source used Word's Bold
                // button rather than typed asterisks.
                var html2 = node.innerHTML
                    .replace(/<(strong|b)[^>]*>/gi, '**').replace(/<\/(strong|b)>/gi, '**')
                    .replace(/<[^>]+>/g, '');
                var tmp = document.createElement('div');
                tmp.innerHTML = html2;
                lines.push((tag === 'li' ? '- ' : '') + tmp.textContent.trim());
            } else {
                var txt = node.textContent.trim();
                if (txt) lines.push(txt);
            }
        });
        return lines.join('\n\n');
    }

    // Reads one .md/.txt/.docx entry out of an open JSZip file and returns
    // its content as plain text/markdown, running it through the same
    // docx->markdown conversion used for a standalone .docx upload.
    async function readZipEntryAsText(name, entry) {
        if (/\.docx$/i.test(name)) {
            if (typeof mammoth === 'undefined') throw new Error('Thư viện đọc .docx chưa tải được.');
            var ab = await entry.async('arraybuffer');
            var result = await mammoth.convertToHtml({ arrayBuffer: ab });
            return docxHtmlToMarkdown(result.value);
        }
        return entry.async('string');
    }

    async function onQuickPasteZip(f, status) {
        BATCH_QUEUE = [];
        if (typeof JSZip === 'undefined') {
            if (status) { status.className = 'qp-status err'; status.textContent = '✗ Thư viện đọc .zip chưa tải được — kiểm tra kết nối mạng rồi thử lại.';}
            return;
        }
        try {
            if (status) { status.className = 'qp-status'; status.textContent = '⏳ Đang giải nén file .zip…'; }
            var buf = await f.arrayBuffer();
            var zip = await JSZip.loadAsync(buf);
            var names = Object.keys(zip.files).filter(function(n) {
                var base = n.split('/').pop();
                return /\.(md|markdown|txt|docx)$/i.test(n) &&
                       !zip.files[n].dir &&
                       base && base.charAt(0) !== '.' &&
                       n.indexOf('__MACOSX') === -1;
            }).sort();

            if (!names.length) {
                if (status) { status.className = 'qp-status err'; status.textContent = '✗ File .zip không chứa file .md/.txt/.docx nào.'; }
                return;
            }

            for (var i = 0; i < names.length; i++) {
                var name = names[i];
                var text = await readZipEntryAsText(name, zip.files[name]);
                BATCH_QUEUE.push({ name: name.split('/').pop(), text: text });
            }

            if (BATCH_QUEUE.length === 1) {
                // Only one test inside the zip — no reason to force the batch
                // path, just behave like a normal single-file upload.
                document.getElementById('qpText').value = BATCH_QUEUE[0].text;
                BATCH_QUEUE = [];
                previewQuickPaste();
                return;
            }

            document.getElementById('qpText').value = '';
            var names2 = BATCH_QUEUE.map(function(e) { return e.name; }).join(', ');
            if (status) {
                status.className = 'qp-status ok';
                status.textContent = '✓ Đã nạp ' + BATCH_QUEUE.length + ' đề từ ZIP: ' + names2 +
                    '. Bấm một trình độ bên dưới để xử lý lần lượt — mỗi đề sẽ tải về 1 file riêng.';
            }
            log('Đã nạp ' + BATCH_QUEUE.length + ' đề từ ZIP (' + names2 + '), sẵn sàng xử lý hàng loạt.', 'ok');
        } catch (err) {
            BATCH_QUEUE = [];
            if (status) { status.className = 'qp-status err'; status.textContent = '✗ Không đọc được file .zip: ' + err.message; }
        }
    }

    async function onQuickPasteFile(input) {
        var f = input.files && input.files[0];
        if (!f) return;
        var status = document.getElementById('qpStatus');

        if (/\.zip$/i.test(f.name)) {
            await onQuickPasteZip(f, status);
            input.value = '';
            return;
        }

        BATCH_QUEUE = []; // a plain single-file upload replaces any pending zip batch

        if (/\.docx$/i.test(f.name)) {
            if (typeof mammoth === 'undefined') {
                if (status) { status.className = 'qp-status err'; status.textContent = '\u2717 Th\u01b0 vi\u1ec7n \u0111\u1ecdc .docx ch\u01b0a t\u1ea3i \u0111\u01b0\u1ee3c \u2014 ki\u1ec3m tra k\u1ebft n\u1ed1i m\u1ea1ng r\u1ed3i th\u1eed l\u1ea1i.'; }
                input.value = ''; return;
            }
            try {
                if (status) { status.className = 'qp-status'; status.textContent = '\u23f3 \u0110ang \u0111\u1ecdc file .docx\u2026'; }
                var arrayBuffer = await f.arrayBuffer();
                var result = await mammoth.convertToHtml({ arrayBuffer: arrayBuffer });
                var md = docxHtmlToMarkdown(result.value);
                document.getElementById('qpText').value = md;
                previewQuickPaste();
            } catch (err) {
                if (status) { status.className = 'qp-status err'; status.textContent = '\u2717 Kh\u00f4ng \u0111\u1ecdc \u0111\u01b0\u1ee3c file .docx: ' + err.message; }
            }
            input.value = '';
            return;
        }

        var r = new FileReader();
        r.onload = function() {
            document.getElementById('qpText').value = r.result;
            previewQuickPaste();
        };
        r.readAsText(f);
        input.value = '';
    }

    function previewQuickPaste() {
        var status = document.getElementById('qpStatus');
        // Manual typing/pasting overrides any zip batch loaded earlier —
        // only onQuickPasteZip() is allowed to populate BATCH_QUEUE.
        BATCH_QUEUE = [];
        var result = splitFullTestText(document.getElementById('qpText').value);
        if (!status) return;
        if (!result.ok) { status.className = 'qp-status'; status.textContent = ''; return; }
        var names = result.passages.map(function(p) { return 'B\u00e0i ' + p.n; }).join(', ');
        status.className = 'qp-status ok';
        status.textContent = '\u2713 Nh\u1eadn di\u1ec7n \u0111\u01b0\u1ee3c: ' + names + '. B\u1ea5m m\u1ed9t tr\u00ecnh \u0111\u1ed9 b\u00ean d\u01b0\u1edbi \u0111\u1ec3 t\u1ea1o \u0111\u1ec1.';
    }

    // Builds the {qN: [answer]} / {qN: "text"} objects using the SAME
    // sequential id scheme (q<start+i>) the prompt instructs the model to
    // use for its <input>/<select> "name" attributes when known answers are
    // supplied — see the "KNOWN ANSWERS" branch in generatePassage(). Because
    // renumber() later re-keys everything by order of appearance in the
    // HTML anyway, this only needs to match that same order, not any
    // particular literal number.
    function buildFromOrderedList(startNum, orderedList, wrapInArray) {
        var out = {};
        for (var i = 0; i < orderedList.length; i++) {
            out['q' + (startNum + i)] = wrapInArray ? [orderedList[i]] : orderedList[i];
        }
        return out;
    }

    // Safety net for T/F/NG and Y/N/NG. If the model renders one as a text box,
    // a student typing "T" or "NG" can be marked wrong on a technicality, so any
    // such text input is converted to a dropdown with exact full-word values.
    var TF_SET = ['TRUE', 'FALSE', 'NOT GIVEN'];
    var YN_SET = ['YES', 'NO', 'NOT GIVEN'];

    function normAns(v) {
        var a = Array.isArray(v) ? v[0] : v;
        return String(a === undefined || a === null ? '' : a).trim().toUpperCase().replace(/\s+/g, ' ');
    }

    function toDropdowns(questionsHTML, answers) {
        var ids = Object.keys(answers);
        var fam = {}, converted = 0;

        // Questions that declare their family outright.
        ids.forEach(function(id) {
            var a = normAns(answers[id]);
            if (a === 'TRUE' || a === 'FALSE')    fam[id] = 'TF';
            else if (a === 'YES' || a === 'NO')   fam[id] = 'YN';
        });
        // NOT GIVEN inherits from its nearest labelled neighbour in either direction.
        ids.forEach(function(id, i) {
            if (fam[id] || normAns(answers[id]) !== 'NOT GIVEN') return;
            for (var d = 1; d < ids.length; d++) {
                var before = ids[i - d], after = ids[i + d];
                if (before && fam[before]) { fam[id] = fam[before]; return; }
                if (after  && fam[after])  { fam[id] = fam[after];  return; }
            }
            fam[id] = 'TF';
        });

        var html = questionsHTML;
        ids.forEach(function(id) {
            if (!fam[id]) return;
            var opts = (fam[id] === 'YN') ? YN_SET : TF_SET;
            // Only plain text inputs; never touch radios, checkboxes or existing selects.
            var re = new RegExp('<input\\b(?![^>]*type\\s*=\\s*"(?:radio|checkbox)")[^>]*name\\s*=\\s*"' + id + '"[^>]*>', 'i');
            if (!re.test(html)) return;
            var sel = '<select name="' + id + '"><option value="">\u2014 Choose \u2014</option>' +
                      opts.map(function(o) { return '<option value="' + o + '">' + o + '</option>'; }).join('') +
                      '</select>';
            html = html.replace(re, sel);
            converted++;
        });
        return { questions: html, converted: converted };
    }

    // Lưới an toàn: câu nào có đáp án nhưng AI KHÔNG render ô nhập (thường là câu
    // dạng nhãn trên sơ đồ/bản đồ nằm trong hình) thì tự tạo ô nhập, gom một nhóm.
    function ensureInputs(questionsHTML, answers) {
        var missing = [];
        Object.keys(answers).forEach(function(id) {
            if (!(new RegExp('name\\s*=\\s*"' + id + '"')).test(questionsHTML)) missing.push(id);
        });
        if (!missing.length) return { questions: questionsHTML, added: 0 };
        missing.sort(function(a, b) {
            return (parseInt(a.replace(/\D/g, ''), 10) || 0) - (parseInt(b.replace(/\D/g, ''), 10) || 0);
        });
        var group = '<div class="q-figset"><div class="q-fighint">Điền đáp án theo hình:</div>';
        missing.forEach(function(id) {
            var num = id.replace(/\D/g, '');
            group += '<div class="q-figrow"><span class="q-fignum">' + num + '</span>' +
                     '<input type="text" name="' + id + '" autocomplete="off"></div>';
        });
        group += '</div>';
        return { questions: questionsHTML + group, added: missing.length };
    }

    // ---- STEP 1 of author mode: write the passage only. -------------------
    async function authorPassage(level, brief, idx, total, usedTopics) {
        var shape = SHAPE[level][Math.min(idx, 2)];
        var auto  = !brief;
        var topic = brief || randomTopic(usedTopics);
        var angle = auto ? pickAngle() : '';

        // Everything this browser has generated before, so the model cannot
        // unknowingly re-tread it. Capped to keep the input payload small.
        var hist      = loadHistory();
        var pastTitle = [], pastOpen = [];
        hist.slice(-45).forEach(function(e) {
            if (e && (e.ti || e.t)) pastTitle.push(e.ti || e.t);
            if (e && e.o) pastOpen.push(e.o);
        });

        var avoid = '';
        if (usedTopics.length) {
            avoid += '\nAlready used elsewhere in THIS SAME PAPER \u2014 do not overlap with: ' + usedTopics.join('; ') + '.\n';
        }
        if (pastTitle.length) {
            avoid += '\nPREVIOUSLY PUBLISHED BY THIS ACADEMY \u2014 students may have already sat these. Your passage must not repeat, revisit or substantially overlap with any of these subjects:\n' +
                     pastTitle.map(function(t) { return '\u2022 ' + t; }).join('\n') + '\n';
        }
        if (pastOpen.slice(-12).length) {
            avoid += '\nOpening lines already used before \u2014 do not begin in a similar way:\n' +
                     pastOpen.slice(-12).map(function(o) { return '\u2022 ' + o + '\u2026'; }).join('\n') + '\n';
        }

        var prompt =
            'You are a senior item writer for Cambridge-style IELTS Academic Reading papers. Write ONE original reading passage. It will be Reading Passage ' + (idx + 1) + ' of ' + total + ' in the paper.\n\n' +
            'TOPIC BRIEF:\n"""\n' + topic + '\n"""\n' +
            (angle ? 'ANGLE: build the passage around ' + angle + '. Do not write a general overview of the subject.\n' : '') +
            avoid +
            '\nLENGTH: ' + shape.w + ' words, plus or minus 10 per cent. Treat this as a hard specification, not a suggestion.\n' +
            'PARAGRAPHS: exactly ' + shape.p + ', each 90\u2013170 words, each built around ONE distinct idea that could be summarised in a single heading.\n' +
            'REGISTER: ' + REGISTER[level] + '\n\n' +
            'ORIGINALITY (CRITICAL):\n' +
            '- Write completely new prose. Do NOT reproduce, translate, adapt, or closely paraphrase any published Cambridge IELTS passage, textbook, article or any other existing text. Nothing you write may be traceable to a real source.\n' +
            '- Base the content on well-established general knowledge. You may use real places, real historical events and realistic figures, but do NOT attribute invented statistics or invented findings to a named real person, university or journal. Keep attributions generic: "one long-running study", "researchers in southern Chile", "a 2011 survey of coastal towns".\n\n' +
            'WHAT MAKES A PASSAGE TESTABLE \u2014 build all of these in deliberately:\n' +
            '1. A development, not a list: a problem and the responses to it, a chronological change, or a claim followed by challenges to it.\n' +
            '2. At least two named or clearly identified people, groups, sites, or schools of thought that hold DIFFERENT positions \u2014 this is what makes Matching Features and opinion questions possible.\n' +
            '3. At least six precise, concrete details spread across different paragraphs (dates, quantities, distances, proportions, materials, place names) that can be tested by completion questions.\n' +
            '4. Several sentences carrying careful qualification \u2014 "only in the driest months", "in the north of the region", "among adults but not children" \u2014 so that a careless reader would over-generalise. These are what make FALSE items work.\n' +
            '5. At least two places where a plausible-sounding related fact is deliberately NOT stated, leaving room for genuine NOT GIVEN items.\n\n' +
            'STYLE RULES:\n' +
            '- Third person, informative and analytical. No direct address to the reader, no rhetorical questions, no "In this article".\n' +
            '- Do NOT open with a broad historical generalisation. "For centuries\u2026", "Throughout history\u2026", "Since ancient times\u2026", "In recent years\u2026" and "It is widely known that\u2026" are all forbidden as opening words. Begin instead with a specific scene, a particular finding, a named place, a concrete figure, or the problem itself.\n' +
            '- Continuous prose only: no sub-headings, no bullet points, no numbered lists.\n' +
            '- Do NOT include or refer to any diagram, map, plan, table, graph or picture. There is no figure.\n' +
            '- Do NOT write any questions, instructions or answer key. The passage only.\n' +
            '- Write the passage ONCE. Do not produce a draft and then a revision, do not offer alternative versions, do not append a word count, a self-check, notes on how you met the brief, or any commentary. Stop generating immediately after the ===GG_END=== line.\n\n' +
            'FORMAT: one <p> per paragraph, each opening with a bold label \u2014 <p><b>A.</b> text\u2026</p>, then <b>B.</b>, and so on.\n\n' +
            'OUTPUT \u2014 use these exact marker lines, each on its own line, nothing before the first and nothing after the last. No markdown, no code fences.\n\n' +
            '===GG_TITLE===\nshort plain-text title, 3\u20138 words, no quotation marks, no "Passage 1" prefix\n' +
            '===GG_PASSAGE===\nthe passage HTML here\n' +
            '===GG_END===';

        var text    = await callClaude(prompt, 16000, 1, passageComplete, 'low');
        var passage = grabBlock(text, '===GG_PASSAGE===', '===GG_END===');
        var title   = grabBlock(text, '===GG_TITLE===', '===GG_PASSAGE===');

        if (!passage) {
            // Model ignored the markers and returned bare HTML — salvage it.
            var bare = text.replace(/```[a-z]*/gi, '').trim();
            if (/<p[\s>]/i.test(bare)) passage = bare;
        }
        if (!passage) throw new Error('Passage ' + (idx + 1) + ': the model returned no passage text.');

        var words = passage.replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;

        // Persist immediately, so a crash on a later passage still leaves this one
        // remembered and it cannot come back next week.
        recordTopic(topic, title, passage, level);

        return { title: title, passage: passage, words: words, topic: topic };
    }

    // ---- STEP 2 of author mode: write and solve the question set. ---------
    async function generateQuestions(level, passageHTML, idx, startNum, qCount) {
        var endNum = startNum + qCount - 1;
        var keys   = SELECTED_TYPES.length ? SELECTED_TYPES : AUTO_TYPES[Math.min(idx + 1, 3)];
        var typeList = keys.map(function(k, i) { return (i + 1) + '. ' + TYPE_LABELS[k]; }).join('\n');

        var simplify = {
            pre:  'The learners are A1\u2013A2. Word the questions and any options in plain, everyday English and keep them short. The reading challenge must sit in the passage, never in decoding the question.',
            fund: 'The learners are B1\u2013B2. Word the questions in ordinary English, avoiding unnecessarily obscure phrasing, while keeping standard IELTS rubric wording.',
            core: 'Use authentic Cambridge rubric wording and full academic phrasing throughout.'
        };

        var prompt =
            'You are an expert IELTS Test Architect. Below is a finished Reading Passage. Write a complete question set for it, then solve every question with PERFECT ACCURACY.\n\n' +
            'PASSAGE (read-only \u2014 do not rewrite, shorten or re-order it; its paragraphs are already labelled A, B, C\u2026):\n"""\n' + passageHTML + '\n"""\n\n' +
            'HOW MANY: exactly ' + qCount + ' questions, numbered ' + startNum + ' to ' + endNum + ' with no gaps and no repeats.\n\n' +
            'TASK TYPES \u2014 group the questions into 3 or 4 consecutive blocks drawn from this list, in this order of preference:\n' + typeList + '\n' +
            (SELECTED_TYPES.length
                ? 'Use ONLY the types listed above. If there are fewer types than blocks, split one type across two blocks rather than introducing a type that is not on the list.\n'
                : 'Choose the 3\u20134 types from that list that this particular passage supports best, and give each block a sensible share of the ' + qCount + ' questions (typically 4\u20136 each).\n') +
            'NEVER use diagram, map, plan or flow-chart label completion: there is no figure with this passage.\n\n' +
            'ITEM-WRITING STANDARDS (this is where most generated tests fail \u2014 obey every line):\n' +
            '- Every answer must be provable from the passage alone. Before you write an answer, find the sentence that proves it.\n' +
            '- The questions must follow the ORDER of the passage within each block (except Matching Headings and Matching Information, which do not).\n' +
            '- TRUE/FALSE/NOT GIVEN and YES/NO/NOT GIVEN: use a spread of all three, and no more than three of any one value in a block. A FALSE item must CONTRADICT the passage; a NOT GIVEN item must be genuinely absent \u2014 not merely unstated in those exact words, and not inferable. Never make a NOT GIVEN item out of something the passage implies clearly. Use TRUE/FALSE/NOT GIVEN for facts, YES/NO/NOT GIVEN only for the writer\'s or a named person\'s claims and opinions.\n' +
            '- Completion items (summary, sentence, note, table, short-answer): the answer MUST be a word or words copied VERBATIM from the passage, never a synonym or a rephrasing. State the word limit in the instruction (e.g. NO MORE THAN TWO WORDS AND/OR A NUMBER) and make sure every answer obeys it. The stem around the blank must paraphrase the passage, not copy it.\n' +
            '- Summary Completion: say clearly whether the answers come from the passage or from a supplied list of words. If from a list, render the word bank once as an <div class="opt-bank"> block with lettered options and use dropdowns.\n' +
            '- Matching Headings: supply MORE headings than there are questions (at least two extra distractors), number them in lower-case roman numerals, and never let two headings fit the same paragraph.\n' +
            '- Multiple Choice: four options A\u2013D, all of similar length and grammatically parallel. Distractors must be plausible and drawn from the passage\'s own content \u2014 each one wrong for a specific, identifiable reason.\n' +
            '- Matching Features / Sentence Endings: include at least two options that are never used as answers.\n' +
            '- No two questions may test the same sentence of the passage.\n' +
            '- ' + simplify[level] + '\n' +
            '- Above each block, write the authentic IELTS instruction line, e.g. "Questions ' + startNum + '\u2013' + (startNum + 5) + '" followed by the standard rubric for that task type. Render each instruction as <p><b>Questions X\u2013Y</b></p> plus a normal paragraph of rubric.\n\n' +
            'HTML RULES FOR THE QUESTION BLOCK:\n' +
            '- Fill-in-the-blank / short-answer / completion: <input type="text" name="q' + startNum + '"> using q' + startNum + ', q' + (startNum + 1) + '\u2026 in order.\n' +
            '- Standard multiple choice: radio inputs sharing the question\'s name.\n' +
            '- EVERY matching question (Headings, Information, Features, Sentence Endings) MUST use a <select> dropdown, never a text box and never radios. Render the shared option list ONCE above the block as <div class="opt-bank"><b>List of Headings</b><br>i. \u2026<br>ii. \u2026</div>, then each question as <select name="qN"><option value="">\u2014 Choose \u2014</option><option value="ii">ii</option>\u2026</select>. The option value must be ONLY the identifier (roman numeral or letter), and every dropdown must contain ALL options including the unused distractors.\n' +
            '- TRUE/FALSE/NOT GIVEN and YES/NO/NOT GIVEN MUST use a <select> dropdown so students cannot lose marks by typing T, F, NG or Y: <select name="qN"><option value="">\u2014 Choose \u2014</option><option value="TRUE">TRUE</option><option value="FALSE">FALSE</option><option value="NOT GIVEN">NOT GIVEN</option></select>. Values must be the full words in capitals.\n\n' +
            'ANSWERS: for each question give an ARRAY of every acceptable variant. TRUE/FALSE/NOT GIVEN \u2192 ["TRUE","T"] etc. Completion \u2192 include singular/plural and with/without article. Multiple choice \u2192 the letter first, then the full option text. Matching \u2192 the identifier FIRST (["iii"], ["B"]), optionally the full text second.\n' +
            'EXPLANATIONS: for each question, 1\u20132 sentences naming the paragraph letter and referring to the exact wording that proves the answer.\n\n' +
            'OUTPUT FORMAT \u2014 use these exact marker lines, each on its own line, nothing before the first and nothing after the last. No markdown, no code fences.\n\n' +
            '===GG_QUESTIONS===\nthe questions HTML here (normal double-quoted attributes like name="q' + startNum + '" are fine; this block is NOT parsed as JSON so nothing needs escaping)\n' +
            '===GG_ANSWERS===\na JSON object ONLY, e.g. {"q' + startNum + '": ["primary","variant"]}\n' +
            '===GG_EXPLANATIONS===\na JSON object ONLY, e.g. {"q' + startNum + '": "Paragraph C states\u2026"}\n' +
            '===GG_END===\n\n' +
            'Inside the ANSWERS and EXPLANATIONS blocks only, escape any double quote as \\" and use \\n instead of a real newline.';

        var text      = await callClaude(prompt, 16000, 1, questionsComplete, QUESTION_EFFORT);
        var questions = grabBlock(text, '===GG_QUESTIONS===', '===GG_ANSWERS===');
        var answers   = safeJSONObject(grabBlock(text, '===GG_ANSWERS===', '===GG_EXPLANATIONS===')) || {};
        var exps      = safeJSONObject(grabBlock(text, '===GG_EXPLANATIONS===', '===GG_END===')) || {};

        if (!questions) throw new Error('Passage ' + (idx + 1) + ': the model returned no questions.');
        if (!Object.keys(answers).length) throw new Error('Passage ' + (idx + 1) + ': the answer key came back empty.');
        return { questions: questions, answers: answers, explanations: exps };
    }

    // Top-level entry point for both level buttons. Decides whether this is
    // a single test (normal paste/upload \u2014 the pre-v11.2 behaviour) or a
    // zip batch (BATCH_QUEUE has more than one entry), and owns the button
    // disable/spinner state for the whole run either way. The actual
    // per-test generation work lives in runSingleTest() below so it can be
    // called once per file in a batch.
    async function buildTest(level, formatOnly) {
        if (!getKey()) {
            log('Error: No API key saved. Add your key at the top of the page first.', 'err');
            showKeyForm();
            return;
        }

        var btns      = document.querySelectorAll('.gen-btn');
        var activeBtn = document.getElementById('btn-' + level + (formatOnly ? '-lbl' : ''));
        btns.forEach(function(b) { b.disabled = true; });
        if (activeBtn) activeBtn.classList.add('loading');

        try {
            if (TEST_MODE === 'convert' && BATCH_QUEUE.length > 1) {
                var queue = BATCH_QUEUE.slice(); // snapshot \u2014 a mid-batch re-upload can't corrupt an in-flight run
                var okCount = 0, failCount = 0;
                log('B\u1eaft \u0111\u1ea7u x\u1eed l\u00fd h\u00e0ng lo\u1ea1t \u00b7 ' + queue.length + ' \u0111\u1ec1 t\u1eeb file ZIP\u2026');
                for (var b = 0; b < queue.length; b++) {
                    var item = queue[b];
                    log('\u2014 File ' + (b + 1) + '/' + queue.length + ': ' + item.name + ' \u2014');
                    try {
                        await runSingleTest(level, item.text, item.name.replace(/\.[^.]+$/, ''), formatOnly);
                        okCount++;
                    } catch (e) {
                        failCount++;
                        log('B\u1ecf qua "' + item.name + '": ' + e.message, 'err');
                    }
                    if (b < queue.length - 1) await sleep(900);
                }
                log('HO\u00c0N T\u1ea4T L\u00d4 \u00b7 ' + okCount + '/' + queue.length + ' \u0111\u1ec1 th\u00e0nh c\u00f4ng' +
                    (failCount ? ', ' + failCount + ' l\u1ed7i (xem log \u1edf tr\u00ean)' : '') + '. ' + okCount + ' file \u0111\u00e3 t\u1ea3i v\u1ec1.',
                    failCount ? 'warn' : 'ok');
            } else {
                var raw = TEST_MODE === 'convert' ? document.getElementById('qpText').value : '';
                await runSingleTest(level, raw, null, formatOnly);
            }
        } catch (e) {
            log('ERROR: ' + e.message, 'err');
        } finally {
            btns.forEach(function(b) { b.disabled = false; });
            if (activeBtn) activeBtn.classList.remove('loading');
        }
    }

    // Label-only entry point (added alongside the AI-simplifying level
    // buttons): reuses the exact same generation pipeline and the exact
    // same title/badge/LEVEL export labeling for the chosen tier, but forces
    // the AI prompt to the Core "preserve exactly as written" instruction
    // regardless of which tier button was clicked, so pasted content is
    // never simplified \u2014 only the title, badges and metadata change. Only
    // meaningful in Convert mode, since Author mode has no existing content
    // to preserve in the first place.
    function buildTestLabelOnly(level) {
        if (TEST_MODE !== 'convert') {
            log('C\u00e1c n\u00fat "Ch\u1ec9 \u0111\u1ed5i ti\u00eau \u0111\u1ec1" ch\u1ec9 d\u00f9ng \u0111\u01b0\u1ee3c \u1edf ch\u1ebf \u0111\u1ed9 d\u00e1n \u0111\u1ec1 c\u00f3 s\u1eb5n (Convert mode) \u2014 Author mode kh\u00f4ng c\u00f3 n\u1ed9i dung n\u00e0o \u0111\u1ec3 gi\u1eef nguy\u00ean c\u1ea3. / Label-only buttons only work in Convert mode \u2014 Author mode has no existing content to keep intact.', 'err');
            return;
        }
        buildTest(level, true);
    }

    // Generates and downloads exactly one test file. `rawText` is the full
    // pasted/uploaded test text (convert mode only \u2014 ignored in author
    // mode); `fileLabel` is the source filename without its extension, used
    // to name the downloaded file distinctly during a zip batch, or null
    // for the normal single-test flow (falls back to the fixed academy
    // title, matching pre-v11.2 behaviour). Throws on failure \u2014 the caller
    // decides whether that aborts the whole run (single test) or is logged
    // and skipped so the rest of the batch keeps going.
    async function runSingleTest(level, rawText, fileLabel, formatOnly) {
        var blocks = [];
        var status = document.getElementById('qpStatus');
        var thisCount = PASSAGE_COUNT; // author mode always uses the fixed 3; convert mode below overrides this to match what was actually pasted

        if (TEST_MODE === 'convert') {
            // Auto-split the whole-test paste right here, at generate time \u2014
            // no separate "split" step for the teacher to remember.
            var raw = rawText;
            var split = splitFullTestText(raw);
            if (!split.ok) {
                if (status) { status.className = 'qp-status err'; status.textContent = '\u2717 ' + split.error; }
                throw new Error(split.error);
            }
            // Accept 1, 2, or 3 passages \u2014 whatever was actually pasted/uploaded.
            // splitFullTestText only ever matches headers "PASSAGE 1/2/3", so
            // this is naturally capped at 3 already.
            thisCount = split.passages.length;
            var filled = [];
            split.passages.forEach(function(p) {
                var keyChunk = split.keyChunks[p.n] || '';
                var qCount = keyChunk ? parseAnswerKeyCombined(keyChunk).answers.length : 0;
                filled.push('B\u00e0i ' + p.n + (qCount ? ' (' + qCount + ' c\u00e2u)' : ' (ch\u01b0a th\u1ea5y \u0111\u00e1p \u00e1n)'));
                blocks.push({ title: p.title || '', body: split.bodies[p.n] || '', answersRaw: keyChunk });
            });
            if (status) { status.className = 'qp-status ok'; status.textContent = '\u2713 \u0110\u00e3 t\u00e1ch: ' + filled.join(', ') + '.'; }
            log((fileLabel ? fileLabel + ' \u00b7 ' : '') + 'T\u1ef1 \u0111\u1ed9ng t\u00e1ch \u0111\u1ec1 \u00b7 ' + filled.join(', ') + '.', 'ok');
        } else {
            // Author mode needs no input at all \u2014 the AI picks its own
            // topics (the empty body is the existing signal for that) and
            // avoids repeats via the topic-memory history.
            for (var i = 1; i <= PASSAGE_COUNT; i++) {
                blocks.push({ title: '', body: '' });
            }
        }

        log('Building ' + level.toUpperCase() + (formatOnly ? ' [LABEL ONLY \u2014 content preserved]' : '') + ' test \u00b7 ' + thisCount + ' passage' + (thisCount > 1 ? 's' : '') + '\u2026');

        var results = [], nextNum = 1;
        var split = qSplit(thisCount), usedTopics = [], authored = null;

        for (var p = 0; p < blocks.length; p++) {
            log('Passage ' + (p + 1) + '/' + thisCount + ' \u2014 generating, questions start at ' + nextNum + '\u2026');

            var data;
            if (TEST_MODE === 'author') {
                var want = split[p];
                log('Passage ' + (p + 1) + ' \u00b7 step 1/2 \u2014 writing an original ' + SHAPE[level][Math.min(p, 2)].w + '-word passage\u2026');
                authored = await authorPassage(level, blocks[p].body, p, thisCount, usedTopics);
                usedTopics.push(authored.topic);
                if (authored.title) usedTopics.push(authored.title);
                log('Passage ' + (p + 1) + ' \u00b7 "' + (authored.title || 'untitled') + '" \u2014 ' + authored.words + ' words written.', 'ok');
                var target = SHAPE[level][Math.min(p, 2)].w;
                if (authored.words > target * 1.35 || authored.words < target * 0.65) {
                    log('Passage ' + (p + 1) + ' \u00b7 word count is well off the ' + target + '-word target \u2014 worth a read before you give it to a class.', 'warn');
                }

                await sleep(700);
                log('Passage ' + (p + 1) + ' \u00b7 step 2/2 \u2014 writing and solving ' + want + ' questions\u2026');
                var qs = await generateQuestions(level, authored.passage, p, nextNum, want);
                data = {
                    title:        authored.title,
                    passage:      authored.passage,
                    questions:    qs.questions,
                    answers:      qs.answers,
                    explanations: qs.explanations
                };
            } else {
                data = await generatePassage(level, blocks[p].body, nextNum, blocks[p].answersRaw || '', formatOnly);
            }

            var fixed = renumber(data.questions, data.answers, data.explanations, nextNum);
            if (!fixed.count) throw new Error('Passage ' + (p + 1) + ': no questions were produced.');
            if (TEST_MODE === 'author' && fixed.count !== split[p]) {
                log('Passage ' + (p + 1) + ' \u00b7 asked for ' + split[p] + ' questions, model produced ' + fixed.count +
                    ' \u2014 numbering re-sequenced automatically so grading stays correct.', 'warn');
            }

            var drop = toDropdowns(fixed.questions, fixed.answers);
            fixed.questions = drop.questions;
            if (drop.converted) {
                log('Passage ' + (p + 1) + ' \u00b7 converted ' + drop.converted + ' T/F/NG answer' +
                    (drop.converted > 1 ? 's' : '') + ' from typing to dropdown.', 'warn');
            }

            var ensured = ensureInputs(fixed.questions, fixed.answers);
            fixed.questions = ensured.questions;
            if (ensured.added) {
                log('Passage ' + (p + 1) + ' \u00b7 t\u1ea1o th\u00eam ' + ensured.added + ' \u00f4 nh\u1eadp cho c\u00e2u theo h\u00ecnh (AI kh\u00f4ng render).', 'warn');
            }

            results.push({
                heading:      blocks[p].title || (data.title || '').trim() || ('Reading Passage ' + (p + 1)),
                passage:      data.passage,
                questions:    fixed.questions,
                answers:      fixed.answers,
                explanations: fixed.explanations,
                first:        nextNum,
                last:         nextNum + fixed.count - 1
            });
            log('Passage ' + (p + 1) + ' ready \u00b7 questions ' + nextNum + '\u2013' + (nextNum + fixed.count - 1) + '.', 'ok');
            nextNum += fixed.count;
            if (p < blocks.length - 1) await sleep(700);
        }

        var testTitle = fileLabel || 'GG Languages Academy - Reading Test';

        log('Packaging student file\u2026');
        exportFile(testTitle, results, level);
        log('SUCCESS \u2014 ' + (nextNum - 1) + ' questions across ' + thisCount + ' passage' + (thisCount > 1 ? 's' : '') + '. File downloaded.', 'ok');
    }

    async function generatePassage(level, input, startNum, knownAnsRaw, formatOnly) {
        var diffMap = {
            pre:  'Simplify the PASSAGE vocabulary and sentence structures by ~25% for Pre-IELTS learners (A1\u2013A2). Use common synonyms and shorter sentences. ALSO simplify the wording of the QUESTIONS and any multiple-choice OPTIONS by the same ~25% \u2014 replace difficult or academic words in the question text with common, everyday vocabulary and use shorter, more direct phrasing. Do NOT change what each question is asking or which answer is correct \u2014 only simplify the language used to express it.',
            fund: 'Simplify the PASSAGE lightly (~15%) for intermediate learners (B1\u2013B2). Keep most vocabulary but replace the most obscure academic words. ALSO lightly simplify the wording of the QUESTIONS and any multiple-choice OPTIONS by ~15% \u2014 replace the most obscure or academic words in the question text with more common alternatives, while keeping sentence structure, meaning, and the correct answer unchanged.',
            core: 'Preserve the PASSAGE exactly as written \u2014 original vocabulary, sentence structure, and academic register. Keep the QUESTIONS and their wording exactly as given in the input, unchanged.'
        };

        // Known answers (and, optionally, explanations embedded in the same
        // paste) supplied by the teacher — e.g. drafted and verified by a
        // local model beforehand. When present, the API's job shrinks: it no
        // longer solves anything, and if explanations were included too, it
        // doesn't write those either — pure formatting only, which is both
        // cheaper and removes the risk of the model silently changing a
        // correct answer while restructuring the text. Understands both
        // "1-TRUE" (plain) and "1-TRUE: because the text says..." (answer +
        // explanation together) in the same box — see parseAnswerKeyCombined().
        var combined = parseAnswerKeyCombined(knownAnsRaw);
        var knownAns = combined.answers;
        var knownExp = combined.explanations;
        var useKnownAns = knownAns.length > 0;
        var useKnownExp = useKnownAns && knownExp.some(function(e) { return e; });

        var head = 'You are an expert IELTS Test Architect with deep knowledge of IELTS reading question types. Process the reading test below with PERFECT ACCURACY.\n\nINPUT TEXT:\n"""\n' + input + '\n"""\n\n';

        var solveStep = useKnownAns
            ? '5. The correct answer for every question is ALREADY VERIFIED and given below, in the SAME order the questions appear in the input. Do NOT solve, re-derive, or second-guess any answer \u2014 use them exactly as given, in order. Do not skip, merge, or reorder any question; your question count MUST equal the number of verified answers given.\n\nVERIFIED ANSWERS IN ORDER (' + knownAns.length + ' total): ' + JSON.stringify(knownAns) + '\n\n'
            : '5. Solve every question with PERFECT ACCURACY \u2014 re-read the passage carefully for each question before answering. Think step by step.\n\n';

        var answersStep = useKnownAns
            ? ''
            : '6. For each answer, provide an ARRAY of ALL acceptable answer variants. Examples:\n   - TRUE/FALSE/NOT GIVEN: ["TRUE", "T"] or ["FALSE", "F"] or ["NOT GIVEN", "NG", "N/G"]\n   - YES/NO/NOT GIVEN: ["YES", "Y"] or ["NO", "N"] or ["NOT GIVEN", "NG"]\n   - Short fill-in: include singular/plural, with/without article, common abbreviations\n   - Multiple choice: include just the letter AND the full option text\n   - Matching (headings/features/paragraphs/endings): the answer array MUST contain the IDENTIFIER that matches the <option> value exactly \u2014 e.g. ["iii"] for a heading, ["B"] for a paragraph/feature/ending. You may add the full text as a second variant, but the identifier MUST be first.\n\n';

        var explainStep = useKnownExp
            ? '7. Explanations are ALREADY WRITTEN and given below, in the SAME order as the questions. Do NOT write your own \u2014 you do not need to output an explanations block at all.\n\nGIVEN EXPLANATIONS IN ORDER: ' + JSON.stringify(knownExp) + '\n\n'
            : useKnownAns
                ? '7. For each answer (using the VERIFIED answer given, not one you derive), write a SHORT explanation (1\u20132 sentences) quoting or referencing the exact part of the passage that proves it.\n\n'
                : '7. For each answer, write a SHORT explanation (1\u20132 sentences) quoting or referencing the exact part of the passage that proves the answer.\n\n';

        var outputSchema = '8. OUTPUT FORMAT (READ CAREFULLY): Do NOT put the passage or questions inside JSON. Return your answer using the EXACT marker lines below. Each marker must be on its own line. Put nothing before the first marker and nothing after the last marker.\n\n' +
            '===GG_TITLE===\nshort plain-text title, no quotation marks\n' +
            '===GG_PASSAGE===\nthe passage HTML here\n' +
            '===GG_QUESTIONS===\nthe questions HTML here (normal double-quoted attributes like name="q1" are perfectly fine here; this block is NOT parsed as JSON, so you do NOT need to escape anything in it)\n' +
            (useKnownAns ? '' : '===GG_ANSWERS===\na JSON object ONLY, for example: {"q1": ["primary_answer", "variant1"], "q2": ["primary_answer", "variant2"]}\n') +
            (useKnownExp ? '' : '===GG_EXPLANATIONS===\na JSON object ONLY, for example: {"q1": "Explanation for q1.", "q2": "Explanation for q2."}\n') +
            '===GG_END===\n\n' +
            (useKnownAns && useKnownExp
                ? 'RESPOND with ONLY the marked blocks above, zero markdown, zero code fences, nothing else.'
                : 'Inside the ANSWERS and EXPLANATIONS blocks only, escape any double-quote as \\" and use \\n instead of a real newline. RESPOND with ONLY the marked blocks above, zero markdown, zero code fences, nothing else.');

        var prompt = head +
            'INSTRUCTIONS:\n1. Separate the PASSAGE from the QUESTIONS.\n2. ' + (formatOnly ? diffMap.core : diffMap[level]) + '\n3. Format the passage as HTML using <p> tags per paragraph. Add a bold label <b>A.</b>, <b>B.</b>, etc. at the start of each paragraph.\n4. Format the questions as clean HTML. Use <input type="text" name="q1"> (q1, q2, q3\u2026 in order) for fill-in-the-blank/short-answer/completion. Use radio inputs for standard multiple choice (A/B/C/D).\n4b. MATCHING QUESTION TYPES \u2014 this covers Matching Headings, Matching Information (which paragraph), Matching Features, and Matching Sentence Endings. For EVERY matching question, you MUST use a <select> dropdown, NEVER a text input or radio. Rules:\n   - First, render the shared list of options ONCE as a reference bank above the questions, e.g. <div class="opt-bank"><b>List of Headings</b><br>i. Heading text<br>ii. Heading text<br>\u2026</div>. Use the IDENTIFIER actually given in the input (roman numerals i, ii, iii for headings; letters A, B, C for paragraphs/features/endings).\n   - Then render each question as: <select name="qN"><option value="">\u2014 Choose \u2014</option><option value="ii">ii</option><option value="iii">iii</option>\u2026</select>. The <option> value MUST be ONLY the identifier (the roman numeral or letter), not the full text.\n   - Include ALL available options in every dropdown (including distractors that are not used as answers).\n4d. TRUE/FALSE/NOT GIVEN and YES/NO/NOT GIVEN \u2014 you MUST use a <select> dropdown, NEVER a text input, so students cannot lose marks by typing T, F, NG or Y. Render each as: <select name="qN"><option value="">\u2014 Choose \u2014</option><option value="TRUE">TRUE</option><option value="FALSE">FALSE</option><option value="NOT GIVEN">NOT GIVEN</option></select>. For YES/NO/NOT GIVEN use YES, NO and NOT GIVEN as the option values instead. Option values MUST be the full word(s) in capitals, never abbreviations.' + (useKnownAns ? ' The given verified answer already tells you which value each dropdown should default toward being correct for \u2014 just make sure the option set matches.' : ' The answer array MUST begin with that exact full value.') + '\n4c. Preserve question numbers and all section instructions exactly.\n4e. DIAGRAM / MAP / PLAN / FLOW-CHART / TABLE LABEL COMPLETION \u2014 when a question set refers to a figure, diagram, map, plan, flow-chart or table, the visual itself is NOT given to you (a separate image will be added later). You MUST STILL create one <input type="text" name="qN"> for EVERY numbered blank in that set, each on its own short line labelled with its number and whatever caption words exist, e.g. <div><b>21</b> <input type="text" name="q21"> km deep</div> or <div><b>23</b> it has <input type="text" name="q23"> of molten rock</div>. NEVER omit a numbered blank just because its content sits inside a figure' + (useKnownAns ? '' : ', and ALWAYS include an answer for every such blank in the answers object') + '.\n' +
            solveStep + answersStep + explainStep + outputSchema;

        // Shift every example question ID in the prompt into this passage's window.
        prompt = prompt
            .split('(q1, q2, q3').join('(q' + startNum + ', q' + (startNum + 1) + ', q' + (startNum + 2))
            .split('"q1"').join('"q' + startNum + '"')
            .split('"q2"').join('"q' + (startNum + 1) + '"');

        var numRules =
            'TITLE:\n' +
            '- Also return a "title" field: the passage\'s own title if the input has one, otherwise a short descriptive title (3\u20138 words) you write yourself. Plain text only \u2014 no HTML, no quotation marks, no "Passage 1" prefix.\n\n' +
            'NUMBERING (CRITICAL):\n' +
            '- The questions for this passage MUST be numbered starting at ' + startNum + '. The first question is number ' + startNum + ', the next is ' + (startNum + 1) + ', and so on in unbroken sequence.\n' +
            '- Use these same numbers in the VISIBLE question text and in every section instruction \u2014 e.g. "Questions ' + startNum + '\u2013' + (startNum + 4) + '".\n' +
            '- Use these same numbers in the input names: name="q' + startNum + '", name="q' + (startNum + 1) + '", and so on.\n' +
            (useKnownAns
                ? '- This numbering order MUST match the order of the VERIFIED ANSWERS list given above \u2014 the first question you output corresponds to the first verified answer, and so on.\n'
                : '- If the input text numbers its questions differently, RENUMBER them into this sequence. Never skip or repeat a number.\n') +
            (useKnownAns ? '' : '- The keys of the "answers" and "explanations" objects MUST match the input names exactly.');

        prompt = prompt.replace('RESPOND with ONLY', numRules + '\n\nRESPOND with ONLY');

        log('Connecting to Claude claude-sonnet-5' + (useKnownAns ? (useKnownExp ? ' (formatting only \u2014 answers & explanations already supplied)' : ' (formatting + explaining \u2014 answers already supplied)') : '') + '\u2026');
        var text = await callClaude(prompt, 16000, 1, questionsComplete, QUESTION_EFFORT);
        log('Response received. Validating structure\u2026');
        var data = parseResponse(text);

        if (!data.passage || !data.questions) {
            throw new Error('AI response missing required fields (passage/questions).');
        }
        if (useKnownAns) {
            data.answers = buildFromOrderedList(startNum, knownAns, true);
        } else if (!data.answers) {
            throw new Error('AI response missing required fields (answers).');
        }
        if (useKnownExp) {
            data.explanations = buildFromOrderedList(startNum, knownExp, false);
        } else if (!data.explanations) {
            log('No explanations returned \u2014 Explain button will fetch them live.', 'warn');
            data.explanations = {};
        }
        return data;
    }


    function esc(s) {
        return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    // ===== Ảnh minh hoạ — quản lý theo khoảng câu hỏi (toàn đề, không theo passage) =====
    // The teacher just says "this image covers questions X to Y"; at export
    // time we look at each passage's final {first, last} question range and
    // route the image to whichever passage actually contains X. No need to
    // know in advance which passage box a given image belongs to.
    // Start with one empty row already showing — for the common case (0 or
    // 1 diagram) this means the file picker is right there immediately,
    // no "add a row first" click needed. An untouched empty row (no file
    // chosen) is simply ignored at export time, so this is harmless even
    // if the teacher never uses it.
    var IMAGE_ENTRIES = [{ id: 1, dataURI: null, fromQ: null, toQ: null }];
    var imgEntrySeq = 1;

    function addImageRow() {
        var id = ++imgEntrySeq;
        IMAGE_ENTRIES.push({ id: id, dataURI: null, fromQ: null, toQ: null });
        renderImageRows();
    }

    function removeImageRow(id) {
        IMAGE_ENTRIES = IMAGE_ENTRIES.filter(function(e) { return e.id !== id; });
        renderImageRows();
    }

    function updateImageRange(id, field, val) {
        var e = IMAGE_ENTRIES.find(function(e) { return e.id === id; });
        if (e) e[field] = val ? parseInt(val, 10) : null;
    }

    function pickImageFile(id) {
        var input = document.getElementById('imgfile-row-' + id);
        if (input) input.click();
    }

    function onImageFile(id, input) {
        var f = input.files && input.files[0];
        if (!f) return;
        if (!/^image\//.test(f.type)) { alert('Vui lòng chọn một file ảnh.'); input.value = ''; return; }
        var r = new FileReader();
        r.onload = function() {
            var img = new Image();
            img.onload = function() {
                var mw = 1000, w = img.width, h = img.height;
                if (w > mw) { h = Math.round(h * mw / w); w = mw; }
                var c = document.createElement('canvas'); c.width = w; c.height = h;
                var ctx = c.getContext('2d');
                ctx.fillStyle = '#fff'; ctx.fillRect(0, 0, w, h);
                ctx.drawImage(img, 0, 0, w, h);
                var data = c.toDataURL('image/png');
                var e = IMAGE_ENTRIES.find(function(e) { return e.id === id; });
                if (e) e.dataURI = data;
                renderImageRows();
            };
            img.src = r.result;
        };
        r.readAsDataURL(f);
    }

    function renderImageRows() {
        var wrap = document.getElementById('imgRows');
        wrap.innerHTML = IMAGE_ENTRIES.map(function(e) {
            var previewHTML = e.dataURI
                ? '<div class="img-preview has"><img src="' + e.dataURI + '" alt="preview">' +
                  '<span class="img-name">\u0111\u00e3 t\u1ea3i l\u00ean</span></div>'
                : '';
            return '<div class="img-row">' +
                '<div class="img-attach">' +
                '<button type="button" class="img-pick" onclick="pickImageFile(' + e.id + ')"><i class="fa-solid fa-upload"></i> ' +
                (e.dataURI ? 'Đổi file ảnh này' : 'Tải file ảnh lên') + '</button>' +
                '<input type="file" id="imgfile-row-' + e.id + '" accept="image/*" hidden onchange="onImageFile(' + e.id + ',this)">' +
                '<span class="img-range-inputs">áp dụng cho câu ' +
                '<input type="number" min="1" value="' + (e.fromQ || '') + '" placeholder="vd 21" onchange="updateImageRange(' + e.id + ',\'fromQ\',this.value)">' +
                ' đến ' +
                '<input type="number" min="1" value="' + (e.toQ || '') + '" placeholder="vd 25" onchange="updateImageRange(' + e.id + ',\'toQ\',this.value)">' +
                '</span>' +
                '<button type="button" class="img-pick" style="border-color:#dc2626;color:#dc2626;" onclick="removeImageRow(' + e.id + ')"><i class="fa-solid fa-trash"></i> Xoá hình này</button>' +
                previewHTML +
                '</div></div>';
        }).join('') || '<div style="font-size:0.8rem;color:var(--text-sub);padding:4px 0;">Chưa có hình nào &mdash; bấm nút bên dưới nếu đề có sơ đồ/bản đồ cần minh hoạ.</div>';

        // Button label makes the relationship to the rows above explicit:
        // "Tải file ảnh lên" fills in an EXISTING row's file; this button
        // creates a brand-new row, for a DIFFERENT diagram/question range.
        var addBtn = document.getElementById('imgAddBtn');
        if (addBtn) {
            addBtn.innerHTML = IMAGE_ENTRIES.length
                ? '<i class="fa-solid fa-plus"></i> Thêm hình khác (nếu đề có nhiều sơ đồ)'
                : '<i class="fa-solid fa-plus"></i> Thêm hình';
        }
    }
