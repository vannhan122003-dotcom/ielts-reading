    // Nếu không thấy marker -> quay về parse JSON kiểu cũ (tương thích ngược).
    function parseResponse(text) {
        function grab(a, b) {
            var i = text.indexOf(a); if (i === -1) return null;
            i += a.length;
            var j = b ? text.indexOf(b, i) : -1;
            if (j === -1) j = text.length;
            return text.substring(i, j).trim();
        }
        var passage   = grab('===GG_PASSAGE===',   '===GG_QUESTIONS===');
        var questions = grab('===GG_QUESTIONS===', '===GG_ANSWERS===');
        if (passage && questions) {
            return {
                title:        grab('===GG_TITLE===', '===GG_PASSAGE===') || '',
                passage:      passage,
                questions:    questions,
                answers:      safeJSONObject(grab('===GG_ANSWERS===', '===GG_EXPLANATIONS===')) || {},
                explanations: safeJSONObject(grab('===GG_EXPLANATIONS===', '===GG_END===')) || {}
