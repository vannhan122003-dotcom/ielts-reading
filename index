        if (starts.length >= 2) {
            var entries = starts.map(function(s, i) {
                var next = starts[i + 1];
                var exp = text.slice(s.end, next ? next.at : text.length)
                              .trim().replace(/^[,;]\s*/, '').replace(/\*+$/, '').trim();
                return { num: s.num, ans: s.ans.replace(/\*+$/, '').trim(), exp: exp };
            });
            entries.sort(function(a, b) { return a.num - b.num; });
            return {
                answers:      entries.map(function(p) { return p.ans; }),
                explanations: entries.map(function(p) { return p.exp; })
