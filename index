    // Forces question IDs to run sequentially from `start`, rewriting the name
    // attributes and the answer/explanation keys together. This guarantees the
    // passages never collide on q1..qN even if the model ignores the numbering
    // instruction in the prompt, so grading can never drift.
    function renumber(questionsHTML, answers, explanations, start) {
        var order = [], seen = {}, m;
        var re = /name\s*=\s*"([^"]+)"/g;
        while ((m = re.exec(questionsHTML)) !== null) {
            if (!seen[m[1]]) { seen[m[1]] = true; order.push(m[1]); }
        }
        // Catch any answer key the model produced but never rendered an input for.
        Object.keys(answers).forEach(function(k) {
            if (!seen[k]) { seen[k] = true; order.push(k); }
        });

        var map = {}, newAns = {}, newExp = {};
        order.forEach(function(oldId, i) { map[oldId] = 'q' + (start + i); });

        var html = questionsHTML.replace(/name\s*=\s*"([^"]+)"/g, function(full, id) {
            return map[id] ? 'name="' + map[id] + '"' : full;
        });
        order.forEach(function(oldId) {
            if (answers[oldId] !== undefined) newAns[map[oldId]] = answers[oldId];
            if (explanations && explanations[oldId] !== undefined) newExp[map[oldId]] = explanations[oldId];
        });
        return { questions: html, answers: newAns, explanations: newExp, count: order.length };
    }

    // ---- Manual answer-key / explanation paste support ---------------------
    // Lets a teacher paste a pre-verified answer key (and optionally
    // explanations, e.g. drafted by a local model) so the API's job on that
    // passage shrinks to pure formatting: no solving, and no explanation
    // writing if explanations were supplied too. Parsing is deterministic
    // (no AI call, no cost) and tolerant of the exact template this tool's
    // own exported answer-key text uses, e.g.:
    //   **Passage 1 (Questions 1-13):** 1-FALSE, 2-TRUE, 3-iii, 9-acidic
    // The leading "Passage N (...):" label, if present, is simply ignored —
    // parsing only looks for "<number> - <answer>" pairs.
    //
    // Returns an ORDERED array of answer strings (sorted by the number given
    // in the pasted text), not an object keyed by that number — because this
    // tool's own renumber() step re-keys everything by ORDER OF APPEARANCE
    // in the generated HTML, not by the literal digits typed here. So all
    // that matters is getting the SEQUENCE right, which this preserves.
    function parseAnswerKeyText(text) {
        text = String(text || '');
        // Strip a leading "Passage N (Questions X-Y):" style header if present —
        // otherwise the "X-Y" question-range itself looks like a valid
        // "number-answer" pair to the regex below and corrupts the first entry.
        text = text.replace(/^[\s\S]*?\(\s*Questions?[^)]*\)\s*:?\**\s*/i, '');
        var pairRe = /(\d+)\s*[.\-)]\s*([^,\n]+?)(?=\s*(?:,|\n)\s*\d+\s*[.\-)]|\s*$)/g;
        var pairs = [], m;
        while ((m = pairRe.exec(text)) !== null) {
            var ans = m[2].trim().replace(/\*+$/, '').trim();
            if (ans) pairs.push({ num: parseInt(m[1], 10), ans: ans });
        }
        pairs.sort(function(a, b) { return a.num - b.num; });
        return pairs.map(function(p) { return p.ans; });
    }

    // Combined-format parser: understands "N-answer: explanation" pasted as
    // ONE block (e.g. "1-TRUE: The text states...", "9-Cretaceous-Paleogene:
    // Taken directly from..."), which is the natural shape an answer key
    // with reasoning already reads in. Falls back to the plain "N-answer"
    // format (no explanations) when no colon-delimited entries are found, so
    // both paste styles work in the same box without the teacher needing to
    // pick a format or split anything by hand.
    function parseAnswerKeyCombined(text) {
        text = String(text || '');
        text = text.replace(/^[\s\S]*?\(\s*Questions?[^)]*\)\s*:?\**\s*/i, '');

